networks:
  hermes_default:
    external: true

volumes:
  uploads: {}

services:
  search_elasticsearch:
    container_name: search_elasticsearch
    image: elasticsearch:8.19.6
    environment:
      - xpack.security.enabled=false
      - "discovery.type=single-node"
      - "ES_JAVA_OPTS=-Xms1g -Xmx1g"
    networks:
      - hermes_default
    ports:
      - "9200:9200"
    deploy:
      resources:
        limits:
          cpus: '2.0'
          memory: 2g
    ulimits:
      memlock:
        soft: -1
        hard: -1
    healthcheck:
      test: [ "CMD", "curl", "-f", "http://localhost:9200" ]
      interval: 10s
      timeout: 5s
      retries: 30

  search_kibana:
    container_name: search_kibana
    image:  kibana:8.19.6
    environment:
      - ELASTICSEARCH_HOSTS="http://search_elasticsearch:9200"
    networks:
      - hermes_default
    depends_on:
      search_elasticsearch:
        condition: service_healthy
    ports:
      - "5601:5601"
    restart: always

  task_api:
    networks:
      - hermes_default
    container_name: task_api
    platform: ${PLATFORM}
    build:
      context: .
      dockerfile: docker/task-api/Dockerfile
      target: server
    depends_on:
      search_redis:
        condition: service_healthy
    ports:
      - "8001:8000"
    environment:
      - FILE_DIR=/uploads
    volumes:
      - uploads:/uploads

  search_redis:
    image: redis:6.2-alpine
    container_name: search_redis
    platform: ${PLATFORM}
    restart: always
    expose:
      - 6379
    networks:
      - hermes_default
    healthcheck:
      test: [ "CMD", "redis-cli", "ping" ]
      interval: 5s
      timeout: 5s
      retries: 20


